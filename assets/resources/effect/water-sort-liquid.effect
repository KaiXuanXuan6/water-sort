CCEffect %{
  techniques:
  - name: transparent
    passes:
    # UI Sprite 必须使用 sprite-vs/sprite-fs；改回 general-vs 会在部分平台触发 UBO 未绑定错误。
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        resolution: { value: [46, 180, 0, 0], editor: { visible: false } }
        color0: { value: [0, 0, 0, 0], editor: { visible: false } }
        color1: { value: [0, 0, 0, 0], editor: { visible: false } }
        color2: { value: [0, 0, 0, 0], editor: { visible: false } }
        color3: { value: [0, 0, 0, 0], editor: { visible: false } }
        height0: { value: [0, 0, 0, 0], editor: { visible: false } }
        height1: { value: [0, 0, 0, 0], editor: { visible: false } }
        height2: { value: [0, 0, 0, 0], editor: { visible: false } }
        height3: { value: [0, 0, 0, 0], editor: { visible: false } }
        tiltWave: { value: [0, 0, 0, 0], editor: { visible: false } }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <legacy/output>
  #include <builtin/uniforms/cc-global>
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;
  in vec2 uv0;

  #define MAX_LAYERS 4

  #pragma builtin(local)
  layout(set = 2, binding = 11) uniform sampler2D cc_spriteTexture;

  layout(std140) uniform Constants {
    vec4 color0;
    vec4 color1;
    vec4 color2;
    vec4 color3;
    vec4 height0;
    vec4 height1;
    vec4 height2;
    vec4 height3;
    vec4 resolution;  // xy = size, zw unused
    vec4 uvRange;     // x=minY, y=maxY, z=minX, w=maxX in spriteFrame UV
    vec4 tiltWave;    // x = tiltAngle, y = waveType; vec4 for engine FLOAT4
  };

  vec4 getLayerColor(int idx) {
    if (idx == 0) return color0;
    if (idx == 1) return color1;
    if (idx == 2) return color2;
    return color3;
  }

  float getLayerHeight(int idx) {
    if (idx == 0) return height0.x;
    if (idx == 1) return height1.x;
    if (idx == 2) return height2.x;
    return height3.x;
  }

  vec4 frag() {
    vec4 texColor = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0) * color;
    if (texColor.a < 0.01) discard;

    float uvSpanY = max(abs(uvRange.y - uvRange.x), 1e-5);
    float fillY = 1.0 - clamp((uv0.y - min(uvRange.x, uvRange.y)) / uvSpanY, 0.0, 1.0);
    float uvSpanX = max(abs(uvRange.w - uvRange.z), 1e-5);
    float normX = clamp((uv0.x - min(uvRange.z, uvRange.w)) / uvSpanX, 0.0, 1.0) - 0.5;

    float totalFill = 0.0;
    for (int i = 0; i < MAX_LAYERS; i++) {
      totalFill += clamp(getLayerHeight(i), 0.0, 1.0);
    }
    totalFill = clamp(totalFill, 0.0, 1.0);

    float angleRad = radians(tiltWave.x);
    // 2D 倒水常用实践：静水面 + 角度斜率 + 体积反比增益 + 体积相关上限。
    // 进一步强化 1 格液量的贴壁能力（低液量更激进）。
    float fillSafe = max(totalFill, 0.25);
    float volumeGain = pow(1.0 / fillSafe, 1.0);
    float lowFillNorm = 1.0 - totalFill;
    float shapeGain = mix(1.0, 1.55, lowFillNorm * lowFillNorm);
    float baseSlope = tan(angleRad) * 0.30;
    float slope = baseSlope * volumeGain * shapeGain;
    float tiltLimit = mix(0.90, 3.20, lowFillNorm);
    float tiltOffset = -normX * clamp(slope, -tiltLimit, tiltLimit);
    // 关键：低液量时放大层高位移，抵消 base(层高) 很小时偏转被压缩的问题。
    float tiltHeightBoost = mix(1.0, 3.5, lowFillNorm);

    int layerCount = 0;
    for (int i = 0; i < MAX_LAYERS; i++) {
      if (getLayerHeight(i) > 0.001) layerCount++;
    }

    float cumHeight = 0.0;
    for (int i = 0; i < MAX_LAYERS; i++) {
      float layerHeight = getLayerHeight(i);
      if (layerHeight < 0.001) continue;

      float prevBase = cumHeight;
      cumHeight += layerHeight;
      float currBase = cumHeight;

      // 底部锚定 + 低液量补偿：液体少时允许更明显贴壁。
      float prevScale = min(1.0, prevBase * tiltHeightBoost);
      float currScale = min(1.0, currBase * tiltHeightBoost);
      float prevHeight = (i == 0) ? 0.0 : clamp(prevBase + tiltOffset * prevScale, 0.0, 1.0);
      float currHeight = clamp(currBase + tiltOffset * currScale, 0.0, 1.0);

      if (i == layerCount - 1 && abs(tiltWave.y) > 0.01) {
        float waveAmp = abs(tiltWave.y - 1.0) < 0.01 ? 0.03 : 0.01;
        float waveFreq = abs(tiltWave.y - 1.0) < 0.01 ? 10.0 : 6.0;
        float waveSpeed = abs(tiltWave.y - 1.0) < 0.01 ? 5.0 : 3.0;
        // 贴壁场景下给波浪预留上下余量，避免被 0/1 clamp 吞掉而“看起来没波”。
        float waveBase = clamp(currHeight, waveAmp * 1.2, 1.0 - waveAmp * 1.2);
        currHeight = clamp(
          waveBase + waveAmp * sin((normX + 0.5) * waveFreq + cc_time.x * waveSpeed),
          0.0, 1.0
        );
      }

      if (currHeight > prevHeight && fillY >= prevHeight && fillY < currHeight) {
        vec4 outColor = texColor * getLayerColor(i);
        ALPHA_TEST(outColor);
        return CCFragOutput(outColor);
      }
    }

    discard;
    return CCFragOutput(vec4(0.0));
  }
}%